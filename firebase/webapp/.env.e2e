# Local emulators only. Every value here is fake on purpose; `demo-` projects
# never reach real Firebase services.
VITE_USE_EMULATORS=1
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-praticos.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-praticos
VITE_FIREBASE_STORAGE_BUCKET=demo-praticos.appspot.com
VITE_FIREBASE_APP_ID=demo-app
VITE_API_BASE_URL=http://127.0.0.1:15001/demo-praticos/southamerica-east1/api
VITE_EMULATOR_AUTH_PORT=19099
VITE_EMULATOR_FIRESTORE_PORT=18080
VITE_EMULATOR_STORAGE_PORT=19199
# Browser notifications: on in the E2E build, with a fixed token (lib/push/token.ts).
VITE_FIREBASE_MESSAGING_SENDER_ID=demo-sender
VITE_FIREBASE_VAPID_KEY=demo-vapid-key
