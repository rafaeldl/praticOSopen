# Production web config. Public by design (the Firebase web apiKey only names
# the project; access is enforced by Auth, the rules and the API), the same
# values firebase/web uses. No secret goes here.
VITE_FIREBASE_API_KEY=AIzaSyCzd0yGNoLaj3KGkrACvLy4lP_ynAYcFms
VITE_FIREBASE_AUTH_DOMAIN=praticos.app
VITE_FIREBASE_PROJECT_ID=praticos
VITE_FIREBASE_STORAGE_BUCKET=praticos.appspot.com
# Firebase web app "PraticOS Website" of the praticos project and its GA4 stream
# (the same one the site uses). Analytics only runs after the person accepts.
VITE_FIREBASE_APP_ID=1:940190275097:web:e627978b56523419a2fc88
VITE_FIREBASE_MEASUREMENT_ID=G-5L7Z0GSM2W
# Browser notifications (lib/push): the project number (also inside the app id).
# They stay off until VITE_FIREBASE_VAPID_KEY (Web Push public key) is set too.
VITE_FIREBASE_MESSAGING_SENDER_ID=940190275097
VITE_API_BASE_URL=https://southamerica-east1-praticos.cloudfunctions.net/api
