# Copy to .env.local to build against a real project. Never commit real values.
# For local work use `npm run dev:emulators`, which reads .env.e2e.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=
# Browser notifications (optional): project number and the Web Push public key.
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
