rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Função para validar tipo e tamanho de imagem
    function isValidImage() {
      // Permite se não houver contentType OU se for uma imagem
      return (request.resource.contentType == null ||
              request.resource.contentType.matches('image/.*')) &&
             request.resource.size < 10 * 1024 * 1024; // 10MB max
    }

    // Função para validar documentos (imagens, PDFs, DOC/DOCX)
    function isValidDocument() {
      return (request.resource.contentType == null ||
              request.resource.contentType.matches('image/.*') ||
              request.resource.contentType == 'application/pdf' ||
              request.resource.contentType == 'application/msword' ||
              request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document') &&
             request.resource.size < 10 * 1024 * 1024; // 10MB max
    }

    // Membro da empresa (custom claim roles[companyId], como no firestore.rules)
    function belongsToCompany(companyId) {
      return request.auth != null
        && request.auth.token.roles != null
        && request.auth.token.roles[companyId] != null;
    }

    // Membro com um destes papéis ('owner' vale como 'admin')
    function hasAnyRole(companyId, roles) {
      return belongsToCompany(companyId)
        && request.auth.token.roles[companyId] in roles;
    }

    function isCompanyAdmin(companyId) {
      return hasAnyRole(companyId, ['owner', 'admin']);
    }

    // Imagem ou PDF até 10MB (comprovante)
    function isValidReceipt() {
      return request.resource.contentType != null
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf')
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Tudo da empresa: leitura e listagem só para membros. Apagar a pasta
    // inteira (exclusão de conta feita pelo app até a versão de out/2026)
    // só para dono/admin. Os caminhos abaixo liberam o resto.
    match /tenants/{companyId}/{allPaths=**} {
      allow read: if belongsToCompany(companyId);
      allow delete: if isCompanyAdmin(companyId);
    }

    // Logo pelo caminho antigo do cadastro (app até out/2026)
    match /companies/{companyId}/{allPaths=**} {
      allow read: if belongsToCompany(companyId);
      allow create, update: if isCompanyAdmin(companyId) && isValidImage();
      allow delete: if isCompanyAdmin(companyId);
    }

    // ─── OS: fotos, documentos, checklist e comprovantes (todos os membros) ───
    match /tenants/{companyId}/orders/{orderId}/photos/{photoId} {
      allow create, update: if belongsToCompany(companyId) && isValidImage();
      allow delete: if belongsToCompany(companyId);
    }

    match /tenants/{companyId}/orders/{orderId}/payments/{txnId}/{fileId} {
      allow create, update: if belongsToCompany(companyId) && isValidDocument();
      allow delete: if belongsToCompany(companyId);
    }

    match /tenants/{companyId}/orders/{orderId}/documents/{docId} {
      allow create, update: if belongsToCompany(companyId) && isValidDocument();
      allow delete: if belongsToCompany(companyId);
    }

    match /tenants/{companyId}/orders/{orderId}/forms/{formId}/{photoId} {
      allow create, update: if belongsToCompany(companyId) && isValidImage();
      allow delete: if belongsToCompany(companyId);
    }

    // Comprovante de um recebimento de cliente (vale para várias OS):
    // enviado uma vez, nunca sobrescrito
    match /tenants/{companyId}/receipts/{receiptId}/{fileId} {
      allow create: if belongsToCompany(companyId) && resource == null && isValidReceipt();
    }

    // ─── Cadastros (mesmos papéis do firestore.rules) ───
    match /tenants/{companyId}/products/{productId}/{photoId} {
      allow create, update: if isCompanyAdmin(companyId) && isValidImage();
      allow delete: if isCompanyAdmin(companyId);
    }

    match /tenants/{companyId}/services/{serviceId}/{photoId} {
      allow create, update: if isCompanyAdmin(companyId) && isValidImage();
      allow delete: if isCompanyAdmin(companyId);
    }

    match /tenants/{companyId}/devices/{deviceId}/{photoId} {
      allow create, update: if hasAnyRole(companyId, ['owner', 'admin', 'supervisor']) && isValidImage();
      allow delete: if hasAnyRole(companyId, ['owner', 'admin', 'supervisor']);
    }

    match /tenants/{companyId}/logo/{logoId} {
      allow create, update: if isCompanyAdmin(companyId) && isValidImage();
      allow delete: if isCompanyAdmin(companyId);
    }

    // Foto de perfil: a própria pessoa, ou dono/admin
    match /tenants/{companyId}/users/{userId}/{photoId} {
      allow create, update: if (isCompanyAdmin(companyId)
          || (belongsToCompany(companyId) && request.auth.uid == userId))
        && isValidImage();
      allow delete: if isCompanyAdmin(companyId)
        || (belongsToCompany(companyId) && request.auth.uid == userId);
    }

    // Bloqueia acesso a qualquer outro caminho não especificado
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
