# PraticOS API Environment Variables

# Bot API Key (for Clawdbot)
BOT_API_KEY=bot_praticos_xxxxx

# Bot WhatsApp Number (E.164 format)
BOT_WHATSAPP_NUMBER=+5511999999999

# Environment
NODE_ENV=development

# Asaas sandbox API key (see docs/ASAAS_INTEGRATION.md). Single quotes because the key starts with $.
ASAAS_SANDBOX_API_KEY='$aact_hmlg_xxxxx'

# Public base URL of the `api` function, used to register the Asaas webhook
# (`<base>/webhooks/asaas/<companyId>`). Defaults to production when unset.
# In local development Asaas cannot reach the emulator: use a tunnel (ngrok).
# ASAAS_WEBHOOK_BASE_URL=https://southamerica-east1-praticos.cloudfunctions.net/api

# ASAAS_CREDENTIALS_KEY is a Secret Manager secret (not an env var):
#   openssl rand -base64 32 | firebase functions:secrets:set ASAAS_CREDENTIALS_KEY --data-file=-
# For the emulator put ASAAS_CREDENTIALS_KEY=<base64 of 32 bytes> in .secret.local (gitignored).

# RevenueCat (Secret Manager secrets, not env vars; see docs/SUBSCRIPTION.md "Secrets"):
#   firebase functions:secrets:set REVENUECAT_WEBHOOK_AUTH      # exact webhook Authorization header value
#   firebase functions:secrets:set REVENUECAT_SECRET_API_KEY    # sk_... (GET /v1/subscribers)
# For the emulator put both in .secret.local (gitignored).

# AI assistant provider (docs/AI_ORDER_ASSIST.md). Per company: settings/ai.provider.
# Turning Claude on for everyone is config/ai.defaultProvider (npm run ai), not an env var.
# AI_PROVIDER=gemini            # gemini | claude (default when the company sets none)
# AI_CLAUDE_MODEL=claude-haiku-5-5   # text and photos; a Sonnet/Opus also gets server-side fallback
# AI_CLAUDE_EFFORT=low
# Gemini answers audio (Claude can't hear it) and is the default provider:
# AI_GEMINI_MODEL=gemini-3.8-flash
# AI_VERTEX_LOCATION=global      # 3.8 answers 404 in southamerica-east1; global may leave Brazil
# AI_GEMINI_THINKING=low         # minimal | low | medium | high (low by default on Gemini 3)
# Checklist photo (POST /v1/app/ai/form-photo) has its own model, separate from the order.
# Default (decided in #701): Gemini 3.8 Flash in global, thinking low. The photo leaves Brazil.
# AI_FORM_PHOTO_PROVIDER=gemini         # gemini (default) | claude | company (the company's provider)
# AI_FORM_PHOTO_GEMINI_MODEL=gemini-3.8-flash
# AI_FORM_PHOTO_VERTEX_LOCATION=global
# AI_FORM_PHOTO_GEMINI_THINKING=low     # minimal | low | medium | high | off (= client default: none on 2.5)
# ANTHROPIC_API_KEY is a Secret Manager secret (not an env var):
#   firebase functions:secrets:set ANTHROPIC_API_KEY
# For the emulator put it in .secret.local (gitignored).

# Plan limits on the server (docs/PLAN_LIMITS_SERVER.md). Off unless exactly "true";
# then config/paidPlans.enabled decides at runtime.
# PLAN_LIMITS_ENABLED=true
