# PraticOS API Environment Variables

# Bot API Key (for Clawdbot)
BOT_API_KEY=bot_praticos_xxxxx

# Bot WhatsApp Number (E.164 format)
BOT_WHATSAPP_NUMBER=+5511999999999

# Environment
NODE_ENV=development

# Asaas sandbox API key (see docs/ASAAS_INTEGRATION.md). Single quotes because the key starts with $.
ASAAS_SANDBOX_API_KEY='$aact_hmlg_xxxxx'
