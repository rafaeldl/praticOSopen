{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "hosting/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      { "source": "/pricing.html", "destination": "/", "type": 301 },
      { "source": "/pricing", "destination": "/", "type": 301 },
      { "source": "/pricing-en.html", "destination": "/index-en.html", "type": 301 },
      { "source": "/pricing-en", "destination": "/index-en.html", "type": 301 },
      { "source": "/pricing-es.html", "destination": "/index-es.html", "type": 301 },
      { "source": "/pricing-es", "destination": "/index-es.html", "type": 301 }
    ],
    "headers": [
      {
        "source": "/mcp/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, no-transform" }
        ]
      },
      {
        "source": "/api/orders/**",
        "headers": [
          { "key": "Cache-Control", "value": "private, no-store" }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=600" }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [
          { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "/app/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "regex": "^/app(/[^.]*)?$",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/app/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/app/**",
        "headers": [
          { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-9KH+o0p3BZIKNYvYzj4XVYanQGWycZx0EE/vGGnXn50=' 'sha256-ad4hJN5Hm7TJbiTnq9hkJL8phcV91kn00HatoWXK7X0=' https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://firebasestorage.googleapis.com https://*.googleusercontent.com; font-src 'self'; connect-src 'self' https://*.googleapis.com https://southamerica-east1-praticos.cloudfunctions.net; frame-src https://praticos.app https://praticos.web.app https://praticos.firebaseapp.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      }
    ],
    "rewrites": [
      { "source": "/app", "destination": "/app/index.html" },
      { "regex": "^/app/[^.]*$", "destination": "/app/index.html" },
      {
        "source": "/mcp/**",
        "function": { "functionId": "api", "region": "southamerica-east1" }
      },
      {
        "source": "/_nuxt/**",
        "run": {
          "serviceId": "praticos-web",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/q/**",
        "run": {
          "serviceId": "praticos-web",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/pro/**",
        "run": {
          "serviceId": "praticos-web",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/admin",
        "run": {
          "serviceId": "praticos-web",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/admin/**",
        "run": {
          "serviceId": "praticos-web",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/admin/**",
        "run": {
          "serviceId": "praticos-web",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/orders/**",
        "run": {
          "serviceId": "praticos-web",
          "region": "southamerica-east1"
        }
      }
    ]
  },
  "emulators": {
    "functions": {
      "port": 5000,
      "host": "0.0.0.0"
    },
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
