{# Status flow — statuses in order. Expects `statuses` = [{ name, class: quote|approved|progress|done|… }]. #}
<ol class="doc-flow" role="list">
    {% for status in statuses %}
    <li><span class="dot dot--{{ status.class }}" aria-hidden="true"></span>{{ status.name }}</li>
    {% endfor %}
</ol>
