{# Profiles — ruled index linking to each profile's section. Expects `profiles` = [{ id, name, description, tag? }];
   legacy emoji/colorClass are ignored. #}
<ul class="doc-index doc-index--meta" role="list">
    {% for profile in profiles %}
    <li>
        <a class="doc-index__link" href="#{{ profile.id }}">
            <span class="doc-index__title">{{ profile.name }}</span>
            {% if profile.tag %}<span class="doc-index__meta label">{{ profile.tag }}</span>{% endif %}
            <span class="doc-index__desc">{{ profile.description }}</span>
        </a>
    </li>
    {% endfor %}
</ul>
