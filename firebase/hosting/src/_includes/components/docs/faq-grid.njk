{# FAQ — native <details>. Expects `items` = [{ question, answer }]; answer may contain inline HTML. #}
<div class="doc-faq">
    {% for item in items %}
    <details>
        <summary>{{ item.question }}</summary>
        <div class="doc-faq__answer"><p>{{ item.answer | safe }}</p></div>
    </details>
    {% endfor %}
</div>
