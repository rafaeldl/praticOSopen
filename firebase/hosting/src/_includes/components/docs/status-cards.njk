{# Status list — dot + name + meaning. Expects `cards` = [{ color: blue|green|orange|yellow|red|purple, title, description }]. #}
<ul class="doc-status" role="list">
    {% for card in cards %}
    <li>
        <span class="dot dot--{{ card.color }}" aria-hidden="true"></span>
        <div>
            <strong>{{ card.title }}</strong>
            <p>{{ card.description | safe }}</p>
        </div>
    </li>
    {% endfor %}
</ul>
