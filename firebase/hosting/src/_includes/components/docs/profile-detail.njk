{# Profile detail — not used by the section renderer (perfis.json renders each profile as a normal section
   with subtitle + notes + permissionsGrid). Kept for templates that include it directly.
   Expects `profile` = { name, subtitle, warningCard?, infoCard? } and `categories`. #}
<h2>{{ profile.name }}</h2>
{% if profile.subtitle %}<p class="doc-subtitle">{{ profile.subtitle }}</p>{% endif %}
{% if profile.warningCard %}{% set note = profile.warningCard %}{% include "components/docs/warning-card.njk" %}{% endif %}
{% if profile.infoCard %}{% set note = profile.infoCard %}{% include "components/docs/info-card.njk" %}{% endif %}
{% include "components/docs/permissions-grid.njk" %}
