{# Status details — one ruled block per status.
   Expects `details` = [{ title, indicatorClass?, description?, paragraphs?, list?, note?,
   permissions?: { canDoTitle, canDo[], cannotDoTitle, cannotDo[] } }]. #}
{% for detail in details %}
<div class="doc-detail">
    <h3>{% if detail.indicatorClass %}<span class="dot dot--{{ detail.indicatorClass }}" aria-hidden="true"></span>{% endif %}<span>{{ detail.title }}</span></h3>
    {% if detail.description %}<p>{{ detail.description | safe }}</p>{% endif %}
    {% for p in detail.paragraphs %}<p>{{ p | safe }}</p>{% endfor %}
    {% if detail.list %}
    <ul>
        {% for item in detail.list %}<li>{{ item | safe }}</li>{% endfor %}
    </ul>
    {% endif %}
    {% if detail.permissions %}
    <div class="doc-cando">
        {% if detail.permissions.canDo %}
        <div>
            <h4>{{ detail.permissions.canDoTitle }}</h4>
            <ul class="perm-list" role="list">
                {% for item in detail.permissions.canDo %}<li><span class="mark-yes" aria-hidden="true">✓</span><span>{{ item | safe }}</span></li>{% endfor %}
            </ul>
        </div>
        {% endif %}
        {% if detail.permissions.cannotDo %}
        <div>
            <h4>{{ detail.permissions.cannotDoTitle }}</h4>
            <ul class="perm-list" role="list">
                {% for item in detail.permissions.cannotDo %}<li class="denied"><span class="mark-no" aria-hidden="true">✕</span><span>{{ item | safe }}</span></li>{% endfor %}
            </ul>
        </div>
        {% endif %}
    </div>
    {% endif %}
    {% if detail.note %}<p class="doc-note-small">{{ detail.note | safe }}</p>{% endif %}
</div>
{% endfor %}
