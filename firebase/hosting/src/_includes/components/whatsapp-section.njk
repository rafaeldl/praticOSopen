{# WhatsApp assistant — only rendered when site.flags.whatsappBot is true #}
{% set wa = (homepage[langCode] | default(homepage.pt)).whatsappAssistant %}
{% set waMsg = site.whatsapp.messages[langCode] | default(site.whatsapp.messages.pt) %}
<section class="section wa-assistant">
    <div class="wrap wa-assistant__grid">
        <div>
            <div class="section-head section-head--stack">
                <h2>{{ wa.title }}</h2>
                <p>{{ wa.text }}</p>
            </div>
            <ul class="stage__facts" role="list">
                {% for feat in wa.features %}<li>{{ feat }}</li>{% endfor %}
            </ul>
            <div class="btn-row">
                <a href="https://wa.me/{{ site.whatsapp.number }}?text={{ waMsg | urlencode }}" target="_blank" rel="noopener" class="btn btn--whatsapp" data-ga="generate_lead" data-ga-detail="whatsapp_assistant_cta">{% include "partials/icon-whatsapp.njk" %}{{ wa.ctaWhatsapp }}</a>
                <a href="{{ relPath }}{{ wa.cta.href }}" class="btn btn--secondary" data-ga="select_content" data-ga-detail="whatsapp_feature_link">{{ wa.cta.text }}</a>
            </div>
        </div>
        <figure class="shot wa-assistant__demo">
            <img src="{{ relPath }}assets/images/whatsapp-bot-demo.webp" alt="{{ wa.demoAlt }}" loading="lazy" decoding="async">
        </figure>
    </div>
</section>
