{% set t = data.testimonial %}
<section class="quote" aria-labelledby="quote-title">
  <div class="wrap">
    <h2 class="quote__title" id="quote-title">{{ t.title }}</h2>
    <figure class="quote__body{% if t.photo %} quote__body--photo{% endif %}">
      {% if t.photo %}<img src="{{ relPath }}{{ t.photo }}" alt="{{ t.name }}" width="640" height="640" loading="lazy">{% endif %}
      <div>
        <blockquote>{{ t.quote }}</blockquote>
        <figcaption><strong>{{ t.name }}</strong> <span>{{ t.role }}</span></figcaption>
      </div>
    </figure>
  </div>
</section>
