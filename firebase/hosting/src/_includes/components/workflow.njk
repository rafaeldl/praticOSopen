{# Feature tabs — the five stages of a work order, each with a real app screen #}
{% set wf = data.workflow %}
<section class="work" id="como-funciona">
    <div class="wrap">
        <h2>{{ wf.title }}</h2>
        <p class="work__lede">{{ wf.lede }}</p>
        <div class="tabs" role="tablist" aria-label="{{ wf.tabsLabel }}" data-tabs>
            {% for stage in wf.stages %}
            <button type="button" role="tab" id="tab-{{ loop.index }}" aria-controls="panel-{{ loop.index }}" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ stage.tab }}</button>
            {% endfor %}
        </div>
        {% for stage in wf.stages %}
        <div class="panel" role="tabpanel" id="panel-{{ loop.index }}" aria-labelledby="tab-{{ loop.index }}"{% if not loop.first %} hidden{% endif %}>
            <div class="panel__copy">
                <h3>{{ stage.title }}</h3>
                <p>{{ stage.text }}</p>
                <ul role="list">
                    {% for fact in stage.facts %}<li>{{ fact }}</li>{% endfor %}
                </ul>
            </div>
            <figure class="panel__shot">
                <img class="theme-light" src="{{ relPath }}assets/screenshots/{{ langCode }}/light/{{ stage.image }}" alt="{{ stage.alt }}" loading="lazy" decoding="async" width="820" height="1240">
                <img class="theme-dark" src="{{ relPath }}assets/screenshots/{{ langCode }}/dark/{{ stage.image }}" alt="{{ stage.alt }}" loading="lazy" decoding="async" width="820" height="1240">
            </figure>
        </div>
        {% endfor %}
    </div>
</section>
