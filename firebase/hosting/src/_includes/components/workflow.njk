{# Feature tabs — the stages of a work order, each with the app screen drawn by stage/.
   "Falar" plays the app filling an order from speech (the hero scene); the others are stills.
   In Portuguese, with site.flags.nfsePage, a last tab shows the service invoice. #}
{% set wf = data.workflow %}
{% set stages = wf.stages %}
{% if site.flags.nfsePage and data.nfse and data.nfse.tab %}{% set stages = stages.concat([data.nfse.tab]) %}{% endif %}
<section class="work" id="como-funciona">
    <div class="wrap">
        <h2>{{ wf.title }}</h2>
        <p class="work__lede">{{ wf.lede }}</p>
        <div class="tabs" role="tablist" aria-label="{{ wf.tabsLabel }}" data-tabs>
            {% for stage in stages %}
            <button type="button" role="tab" id="tab-{{ loop.index }}" aria-controls="panel-{{ loop.index }}" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}{% if stage.id %} data-tab-id="{{ stage.id }}"{% endif %}>{{ stage.tab }}</button>
            {% endfor %}
        </div>
        {% for stage in stages %}
        <div class="panel" role="tabpanel" id="panel-{{ loop.index }}" aria-labelledby="tab-{{ loop.index }}"{% if not loop.first %} hidden{% endif %}>
            <div class="panel__copy">
                <h3>{{ stage.title }}</h3>
                <p>{{ stage.text }}</p>
                <ul role="list">
                    {% for fact in stage.facts %}<li>{{ fact }}</li>{% endfor %}
                </ul>
                {% if stage.cta %}
                <div class="panel__more">
                    <a href="{{ relPath }}{{ stage.cta.href }}" class="btn btn--secondary" data-ga="select_content" data-ga-detail="{{ stage.cta.ga }}">{{ stage.cta.label }}</a>
                    {% if stage.note %}<p class="panel__note">{{ stage.note | safe }}</p>{% endif %}
                </div>
                {% endif %}
            </div>
            {% if stage.scene.kind == 'talk' %}
            {# Animated: the hero scene (Nova OS filled from speech). With ?hero=mix the hero already
               plays it, so this tab falls back to its still (the spoken correction). #}
            <div class="panel__scene panel__scene--live" data-stage-wrap>
                <div data-stage="hero" role="img" aria-label="{{ data.hero.stage.label }}"><script type="application/json">{{ data.hero.stage | dump | safe }}</script></div>
                <button class="stage-again" type="button" data-stage-replay hidden>{{ data.hero.demo.again }}</button>
            </div>
            <div class="panel__scene panel__scene--still" data-stage="tab" role="img" aria-label="{{ stage.scene.label }}"><script type="application/json">{{ stage.scene | dump | safe }}</script></div>
            {% else %}
            {# The app screen for this stage, drawn as a still (stage/scenes/tabs) #}
            <div class="panel__scene" data-stage="tab" data-icon="{{ relPath }}assets/images/logo-96.png" role="img" aria-label="{{ stage.scene.label }}"><script type="application/json">{{ stage.scene | dump | safe }}</script></div>
            {% endif %}
        </div>
        {% endfor %}
    </div>
</section>
