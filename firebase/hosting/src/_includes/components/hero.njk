{# Product hero — headline left, the app on an iPhone writing the work order from speech right #}
{% set hero = data.hero %}
{% set demo = hero.demo %}
<section class="hero" id="hero">
    <div class="wrap hero__grid">
        <div class="hero__copy">
            <h1>{{ hero.titleBefore }}
<span class="hero__mark">{{ hero.titleMark }}</span></h1>
            <p class="hero__lede">{{ hero.lede }}</p>
            <div class="hero__stores">
                <a href="{{ site.appStore }}" target="_blank" rel="noopener" class="btn btn--primary" data-ga="cta_click" data-ga-detail="hero_app_store">{{ hero.ctaAppStore }}</a>
                <a href="{{ site.playStore }}" target="_blank" rel="noopener" class="btn hero__btn-line" data-ga="cta_click" data-ga-detail="hero_play_store">{{ hero.ctaPlayStore }}</a>
            </div>
        </div>

        {# The product scene: the app's "Nova OS" sheet filling itself from speech
           (stage/scenes/hero, built into assets/stage/). Plays once; replay below. #}
        <div class="hero__stage">
            <div class="hero__scene" data-stage="hero" role="img" aria-label="{{ hero.stage.label }}"><script type="application/json">{{ hero.stage | dump | safe }}</script></div>
            <button class="hero__again" type="button" data-stage-replay="hero" hidden>{{ demo.again }}</button>
        </div>
    </div>
</section>

<div class="strip">
    <ul class="wrap" role="list">
        {% for item in (hero.stripWebApp if site.flags.webApp else hero.strip) %}<li>{% if loop.last and site.flags.nfsePage and hero.stripNfse %}<a class="strip__link" href="#nota-fiscal">{{ hero.stripNfse }}</a>{% else %}{{ item }}{% endif %}</li>{% endfor %}
    </ul>
</div>
<link rel="stylesheet" href="{{ relPath }}assets/stage/shared.css">
<script type="module" src="{{ relPath }}assets/stage/hero.js"></script>
