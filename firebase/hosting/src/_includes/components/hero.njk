{# H2 · split diptych — headline left, a sample work order (Tier-A HTML/CSS) right #}
{% set hero = data.hero %}
{% set t = hero.ticket %}
<section class="hero" id="hero">
    <div class="wrap hero__grid">
        <div class="hero__copy">
            <h1>{{ hero.titleBefore }} <span class="mark">{{ hero.titleMark }}</span></h1>
            <p class="lede">{{ hero.lede }}</p>
            <div class="btn-row">
                <a href="#baixar" class="btn btn--primary" data-ga="cta_click" data-ga-detail="hero_download">{{ hero.ctaPrimary }}</a>
                <a href="#como-funciona" class="btn btn--secondary" data-ga="select_content" data-ga-detail="hero_how_it_works">{{ hero.ctaSecondary }}</a>
            </div>
            <p class="hero__note mono">{{ hero.note }}</p>
        </div>

        <figure class="ticket" aria-label="{{ t.caption }}">
            <figcaption class="ticket__caption label">{{ t.caption }}</figcaption>
            <div class="ticket__sheet">
                <header class="ticket__head">
                    <span class="ticket__title">{{ t.title }}</span>
                    <span class="ticket__number mono">{{ t.number }}</span>
                </header>
                <dl class="ticket__rows">
                    {% for row in t.rows %}
                    <div class="ticket__row"><dt>{{ row.label }}</dt><dd>{{ row.value }}</dd></div>
                    {% endfor %}
                    <div class="ticket__row ticket__row--total"><dt>{{ t.totalLabel }}</dt><dd class="mono">{{ t.total }}</dd></div>
                </dl>
                <p class="ticket__stamp" aria-hidden="true">{{ t.stamp }}</p>
                <ol class="ticket__steps" role="list">
                    {% for step in t.steps %}
                    <li class="{% if loop.index0 < t.current %}is-done{% elif loop.index0 == t.current %}is-current{% endif %}"{% if loop.index0 == t.current %} aria-current="step"{% endif %}>{{ step }}</li>
                    {% endfor %}
                </ol>
            </div>
        </figure>
    </div>
</section>
