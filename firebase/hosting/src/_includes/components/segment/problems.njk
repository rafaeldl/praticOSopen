{# Where the trade loses money → what changes with PraticOS. Rows, not cards. #}
{% set pb = data.problems %}
<section class="seg-gains" id="problemas">
    <div class="wrap">
        <h2>{{ pb.title }}</h2>
        {% if pb.lede %}<p class="work__lede">{{ pb.lede }}</p>{% endif %}
        <ul class="seg-gains__list" role="list">
            {% for item in pb.items %}
            <li>
                <div>
                    <h3>{{ item.problem }}</h3>
                    <p>{{ item.detail }}</p>
                </div>
                <p class="seg-gains__answer">{{ item.answer }}</p>
            </li>
            {% endfor %}
        </ul>
    </div>
</section>
