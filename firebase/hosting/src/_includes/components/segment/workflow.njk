{# Feature tabs, like the home (components/workflow.njk): each tab shows the app screen drawn by
   stage/, fed with this trade's example (segments/<slug>.json → workflow.stages[i].scene).
   "Falar" plays the hero scene (short screen); the others are stills (stage/scenes/tabs).
   In Portuguese, with site.flags.nfsePage, a last tab shows the service invoice: the home's copy
   (homepage.pt.nfse.tab) with this trade's order (workflow.invoice). #}
{% set wf = data.workflow %}
{% set home = homepage[langCode] | default(homepage.pt) %}
{% set stages = wf.stages %}
{% if langCode == 'pt' and site.flags.nfsePage and wf.invoice and home.nfse and home.nfse.tab %}
{% set stages = stages.concat([home.nfse.tab | merge({ scene: wf.invoice })]) %}
{% endif %}
<section class="work" id="como-funciona">
    <div class="wrap">
        <h2>{{ wf.title }}</h2>
        {% if wf.lede %}<p class="work__lede">{{ wf.lede }}</p>{% endif %}
        <div class="tabs" role="tablist" aria-label="{{ ui.tabsLabel }}" data-tabs>
            {% for stage in stages %}
            <button type="button" role="tab" id="tab-{{ loop.index }}" aria-controls="panel-{{ loop.index }}" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}{% if stage.id %} data-tab-id="{{ stage.id }}"{% endif %}>{{ stage.tab | default(loop.index) }}</button>
            {% endfor %}
        </div>
        {# All panels share one grid cell: the box keeps the tallest one's height, so switching
           tabs never changes the page's height, and the hidden scenes stay laid out (no flash) #}
        <div class="panels">
        {% for stage in stages %}
        <div class="panel" role="tabpanel" id="panel-{{ loop.index }}" aria-labelledby="tab-{{ loop.index }}"{% if loop.first %} data-active{% else %} aria-hidden="true" inert{% endif %}>
            <div class="panel__copy">
                <h3>{{ stage.title }}</h3>
                <p>{{ stage.text }}</p>
                {% if stage.facts %}
                <ul role="list">
                    {% for fact in stage.facts %}<li>{{ fact }}</li>{% endfor %}
                </ul>
                {% endif %}
                {% if stage.cta %}
                <div class="panel__more">
                    <a href="{{ relPath }}{{ stage.cta.href }}" class="btn btn--secondary" data-ga="select_content" data-ga-detail="{{ stage.cta.ga }}">{{ stage.cta.label }}</a>
                    {% if stage.note %}<p class="panel__note">{{ stage.note | safe }}</p>{% endif %}
                </div>
                {% endif %}
            </div>
            {% if stage.scene.kind == 'talk' %}
            {# Animated: the app filling the order from what was said (stage/scenes/hero, short).
               The trade gives its words (customer, device, what was said, services); the app's
               own words come from the home's hero.stage #}
            {% set talk = home.hero.stage | merge(stage.scene) %}
            <div class="panel__scene panel__scene--live" data-stage-wrap>
                <div data-stage="hero" data-short role="img" aria-label="{{ talk.label }}"><script type="application/json">{{ talk | dump | safe }}</script></div>
                <button class="stage-again" type="button" data-stage-replay hidden>{{ home.hero.demo.again }}</button>
            </div>
            {% elif stage.scene %}
            <div class="panel__scene" data-stage="tab" data-icon="{{ relPath }}assets/images/logo-96.png" role="img" aria-label="{{ stage.scene.label }}"><script type="application/json">{{ stage.scene | dump | safe }}</script></div>
            {% endif %}
        </div>
        {% endfor %}
        </div>
    </div>
</section>
{# Product scenes (stage/): React, the kit and every scene's CSS in shared.*; one module per scene #}
<link rel="stylesheet" href="{{ relPath }}assets/stage/shared.css">
<script type="module" src="{{ relPath }}assets/stage/hero.js"></script>
<script type="module" src="{{ relPath }}assets/stage/tabs.js"></script>
