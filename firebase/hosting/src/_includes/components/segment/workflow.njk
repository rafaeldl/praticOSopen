{# Feature tabs, like the home. Screens stay only where they show this trade's data (see design.md). #}
{% set wf = data.workflow %}
<section class="work" id="como-funciona">
    <div class="wrap">
        <h2>{{ wf.title }}</h2>
        {% if wf.lede %}<p class="work__lede">{{ wf.lede }}</p>{% endif %}
        <div class="tabs" role="tablist" aria-label="{{ ui.tabsLabel }}" data-tabs>
            {% for stage in wf.stages %}
            <button type="button" role="tab" id="tab-{{ loop.index }}" aria-controls="panel-{{ loop.index }}" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ stage.tab | default(loop.index) }}</button>
            {% endfor %}
        </div>
        {# Same tab script as the home; here each panel keeps its own height (panels--own): the
           text-only panels would sit in empty space next to the one with an old screenshot #}
        <div class="panels panels--own">
        {% for stage in wf.stages %}
        <div class="panel{% if not stage.image %} panel--text{% endif %}" role="tabpanel" id="panel-{{ loop.index }}" aria-labelledby="tab-{{ loop.index }}"{% if loop.first %} data-active{% else %} aria-hidden="true" inert{% endif %}>
            <div class="panel__copy">
                <h3>{{ stage.title }}</h3>
                <p>{{ stage.text }}</p>
                {% if stage.image and stage.facts %}
                <ul role="list">
                    {% for fact in stage.facts %}<li>{{ fact }}</li>{% endfor %}
                </ul>
                {% endif %}
            </div>
            {% if stage.image %}
            <figure class="panel__shot">
                <img class="theme-light" src="{{ relPath }}assets/screenshots/{{ langCode }}/light/{{ stage.image }}" alt="{{ stage.alt }}" loading="lazy" decoding="async" width="820" height="1240">
                <img class="theme-dark" src="{{ relPath }}assets/screenshots/{{ langCode }}/dark/{{ stage.image }}" alt="{{ stage.alt }}" loading="lazy" decoding="async" width="820" height="1240">
            </figure>
            {% elif stage.facts %}
            <ul class="panel__facts" role="list">
                {% for fact in stage.facts %}<li>{{ fact }}</li>{% endfor %}
            </ul>
            {% endif %}
        </div>
        {% endfor %}
        </div>
    </div>
</section>
