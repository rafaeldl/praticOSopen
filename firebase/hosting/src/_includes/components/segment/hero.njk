{# Photographic hero, like the home: headline left, the trade's photo right with a sample order over it #}
{% set hero = data.hero %}
{% set t = hero.ticket %}
{% set tradeName = '' %}
{% for link in (segments[langCode] | default(segments.pt)).links %}{% if segmentSlug ~ '.html' in link.href or segmentSlug ~ '-' ~ langCode ~ '.html' in link.href %}{% set tradeName = link.label %}{% endif %}{% endfor %}
<section class="hero seg-top" id="hero">
    <div class="wrap hero__grid seg-top__grid">
        <div class="hero__copy">
            <h1>{{ hero.title }} <span class="hero__mark">{{ hero.titleMark }}</span></h1>
            <p class="hero__lede">{{ hero.lede }}</p>
            <div class="hero__stores">
                <a href="#baixar" class="btn btn--primary" data-ga="cta_click" data-ga-detail="segment_hero_download">{{ hero.ctaPrimary | default(ui.ctaPrimary) }}</a>
                <a href="#como-funciona" class="btn hero__btn-line" data-ga="select_content" data-ga-detail="segment_hero_how_it_works">{{ hero.ctaSecondary | default(ui.ctaSecondary) }}</a>
            </div>
            <p class="seg-top__note">{{ ui.imageNote }}</p>
        </div>

        <div class="seg-photo">
            <figure class="tile seg-photo__tile">
                <img src="{{ relPath }}assets/images/site/segments-hero/{{ segmentSlug }}.webp" alt="{{ tradeName }}" width="960" height="1192" decoding="async" fetchpriority="high">
                <figcaption class="tag">{{ tradeName }}</figcaption>
            </figure>
            <figure class="demo seg-order" aria-label="{{ t.caption }}">
                <figcaption class="seg-order__head">{{ t.caption }}</figcaption>
                <dl class="demo__order">
                    {# Customer, item and service only: the card must leave the person in the photo visible #}
                    {% set third = t.rows[2] if t.rows[2].label in ['Serviço', 'Service', 'Servicio'] else t.rows[3] %}
                    {% for row in [t.rows[0], t.rows[1], third] %}
                    <div class="demo__row"><dt>{{ row.label }}</dt><dd>{{ row.value }}</dd></div>
                    {% endfor %}
                    <div class="demo__row demo__row--total"><dt>{{ t.totalLabel }}</dt><dd>{{ t.total }}</dd></div>
                </dl>
                {% if t.stamp %}<p class="demo__done">{{ t.stamp }}</p>{% endif %}
            </figure>
        </div>
    </div>
</section>
<section class="strip" aria-label="{{ ui.tabsLabel }}">
    <div class="wrap">
        <ul role="list">
            {% for item in ui.strip %}<li>{{ item }}</li>{% endfor %}
        </ul>
    </div>
</section>
