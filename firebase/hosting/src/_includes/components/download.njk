{# Final CTA band — store links + human contact #}
{% set dl = (homepage[langCode] | default(homepage.pt)).download %}
{% set waMsg = site.whatsapp.messages[langCode] | default(site.whatsapp.messages.pt) %}
{% set faqHref = {pt: 'faq.html', en: 'faq-en.html', es: 'faq-es.html'}[langCode] | default('faq.html') %}
<section class="cta-final" id="baixar">
    <div class="wrap">
        {% if site.flags.webSignup %}
        <h2 class="on-desktop">{{ dl.titleWeb }}</h2>
        <h2 class="on-phone">{{ dl.title }}</h2>
        {% else %}
        <h2>{{ dl.title }}</h2>
        {% endif %}
        <p>{{ dl.text }}</p>
        {% if site.flags.webSignup %}
        <div class="cta-final__stores on-desktop">
            <a href="{{ site.webSignupUrl }}" class="btn btn--primary" data-ga="cta_click" data-ga-detail="download_web_signup">{{ dl.signup }}</a>
        </div>
        <p class="cta-final__apps on-desktop">
            <span>{{ dl.appsLead }}</span>
            <a href="{{ site.appStore }}" target="_blank" rel="noopener" data-ga="cta_click" data-ga-detail="download_app_store_desktop">{{ dl.appStore.name }}</a>
            <a href="{{ site.playStore }}" target="_blank" rel="noopener" data-ga="cta_click" data-ga-detail="download_play_store_desktop">{{ dl.playStore.name }}</a>
        </p>
        {% endif %}
        <div class="cta-final__stores{% if site.flags.webSignup %} on-phone{% endif %}">
            <a href="{{ site.appStore }}" target="_blank" rel="noopener" class="btn btn--primary" data-ga="cta_click" data-ga-detail="download_app_store">{{ dl.appStore.label }} {{ dl.appStore.name }}</a>
            <a href="{{ site.playStore }}" target="_blank" rel="noopener" class="btn btn--line" data-ga="cta_click" data-ga-detail="download_play_store">{{ dl.playStore.label }} {{ dl.playStore.name }}</a>
        </div>
        <p class="cta-final__contact">
            <span>{{ dl.contactLead }}</span>
            {% if site.flags.whatsappContact %}<a href="https://wa.me/{{ site.whatsapp.number }}?text={{ waMsg | urlencode }}" target="_blank" rel="noopener" data-ga="generate_lead" data-ga-detail="cta_whatsapp_contact">{{ dl.contactWhatsapp }}</a>{% endif %}
            <a href="mailto:{{ site.email }}" data-ga="generate_lead" data-ga-detail="email_link">{{ site.email }}</a>
            <a href="{{ relPath }}{{ faqHref }}">{{ dl.contactFaq }}</a>
            {% if site.flags.pricingPage and dl.pricesLink and pageType != 'pricing' %}<a href="{{ relPath }}{{ {pt: 'precos.html', en: 'precos-en.html', es: 'precos-es.html'}[langCode] | default('precos.html') | prettyUrl }}" data-ga="select_content" data-ga-detail="download_prices">{{ dl.pricesLink }}</a>{% endif %}
        </p>
    </div>
</section>
