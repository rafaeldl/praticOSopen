{# Photo mural of every trade — doubles as internal linking for SEO #}
{% set seg = segments[langCode] | default(segments.pt) %}
{% set sg = (homepage[langCode] | default(homepage.pt)).segments %}
{% set wideSlugs = ['automotivo', 'refrigeracao', 'assistencia-celular', 'eletrica'] %}
{% macro tradeCard(segment, slug, wide, relPath) %}
<li class="trade{% if wide %} trade--wide{% endif %}">
    <a href="{{ relPath }}{{ segment.href | prettyUrl }}">
        <img src="{{ relPath }}assets/images/site/segments/{{ slug }}.webp" alt="" loading="lazy" decoding="async" width="{{ 800 if wide else 560 }}" height="{{ 993 if wide else 695 }}">
        <span>{{ segment.label }}</span>
    </a>
</li>
{% endmacro %}
<section class="trades" id="segmentos">
    <div class="wrap">
        <h2>{{ sg.title }}</h2>
        <p class="trades__lede">{{ sg.lede }}</p>
        <ul class="mural" role="list">
            {% for pass in ['wide', 'rest'] %}
            {% for segment in seg.links %}
            {% set slug = segment.href | replace('segmentos/', '') | replace('-en.html', '') | replace('-es.html', '') | replace('.html', '') %}
            {% set wide = slug in wideSlugs %}
            {% if (pass == 'wide' and wide) or (pass == 'rest' and not wide) %}{{ tradeCard(segment, slug, wide, relPath) }}{% endif %}
            {% endfor %}
            {% endfor %}
        </ul>
        <p class="trades__note">{{ sg.imageNote }}</p>
    </div>
</section>
