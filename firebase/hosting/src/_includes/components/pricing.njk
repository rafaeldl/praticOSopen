{# Plan sheet — three columns of one ruled table; subscribing happens in the app #}
{% set price = pricing[langCode] | default(pricing.pt) %}
{% set homeHref = relPath ~ (indexPage | default('index.html') | prettyUrl) %}
<section class="section plans" id="planos">
    <div class="wrap">
        <div class="section-head">
            <h2>{{ price.title }}</h2>
            <p class="mono plans__terms">{{ price.subtitle | join(' · ') }}</p>
        </div>
        <div class="plans__sheet">
            {% for plan in price.plans %}
            <article class="plan{% if plan.featured %} plan--featured{% endif %}">
                <header class="plan__head">
                    <h3>{{ plan.name }}{% if plan.badge %} <span class="plan__badge label">{{ plan.badge }}</span>{% endif %}</h3>
                    <p class="plan__tagline">{{ plan.tagline }}</p>
                    <p class="plan__price mono"><span class="plan__currency">{{ plan.currency }}</span>{{ plan.price }}<span class="plan__period">{{ plan.period }}</span></p>
                </header>
                <ul class="plan__features" role="list">
                    {% for feature in plan.features %}<li{% if (feature.text | last) == ":" %} class="is-lead"{% endif %}>{{ feature.text }}</li>{% endfor %}
                </ul>
                <a href="{% if isHomepage %}#baixar{% else %}{{ homeHref }}#baixar{% endif %}" class="btn {% if plan.featured %}btn--primary{% else %}btn--secondary{% endif %}" data-ga="select_content" data-ga-detail="pricing_{{ plan.name | lower | replace(' ', '_') }}">{{ plan.cta }}</a>
            </article>
            {% endfor %}
        </div>
        <p class="plans__more"><a class="link" href="{{ relPath }}{{ price.detailsLink }}" data-ga="select_content" data-ga-detail="pricing_details_link">{{ price.detailsText }}</a></p>
    </div>
</section>
