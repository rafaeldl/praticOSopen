{% set waLangCode = langCode | default('pt') %}
{% set waMsg = site.whatsapp.messages[waLangCode] | default(site.whatsapp.messages.pt) %}
{% set waLabels = { pt: "Falar no WhatsApp", en: "Chat on WhatsApp", es: "Hablar por WhatsApp" } %}
{% set waLabel = waLabels[waLangCode] | default(waLabels.pt) %}
<a href="https://wa.me/{{ site.whatsapp.number }}?text={{ waMsg | urlencode }}" target="_blank" rel="noopener" class="wa-float" aria-label="{{ waLabel }}" data-ga="generate_lead" data-ga-detail="whatsapp_float">
    {% include "partials/icon-whatsapp.njk" %}
    <span class="wa-float__label">{{ waLabel }}</span>
</a>
