{# N1b · wordmark left · centred links + segments dropdown · lang/theme/CTA right #}
{% set nav = navigation[langCode] | default(navigation.pt) %}
{% set seg = segments[langCode] | default(segments.pt) %}
{% set homeHref = relPath ~ (indexPage | default('index.html') | prettyUrl) %}

<a class="skip-link" href="#conteudo">{{ nav.skip }}</a>
<header class="nav" data-nav>
    <div class="nav__inner">
        <a href="{{ homeHref }}" class="brand" aria-label="{{ nav.home }}">
            <img src="{{ relPath }}assets/images/logo-96.png" alt="" width="32" height="32">
            <span class="brand__word">Pratic<b>OS</b></span>
        </a>

        <nav class="nav__center" aria-label="Principal">
            {% for link in nav.links %}
        {% if not link.flag or site.flags[link.flag] %}
            {% if link.segments %}
            <div class="nav__item" data-dropdown>
                <button class="nav__link" type="button" aria-expanded="false" aria-haspopup="true">
                    {{ seg.title }}
                    <svg class="nav__caret" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 4.5L6 8l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="nav__dropdown">
                    <div class="nav__dropdown-head">
                        <span class="label">{{ nav.segmentsAll }}</span>
                    </div>
                    <div class="nav__dropdown-grid">
                        {% for segment in seg.links %}
                        <a href="{{ relPath }}{{ segment.href | prettyUrl }}" class="nav__dropitem"{% if segmentSlug and segment.href.indexOf('/' ~ segmentSlug) != -1 %} aria-current="page"{% endif %}>{{ segment.label }}</a>
                        {% endfor %}
                    </div>
                </div>
            </div>
            {% elif (link.href | first) == '#' %}
            <a class="nav__link" href="{% if isHomepage %}{{ link.href }}{% else %}{{ homeHref }}{{ link.href }}{% endif %}">{{ link.label }}</a>
            {% else %}
            <a class="nav__link" href="{{ relPath }}{{ link.href | prettyUrl }}">{{ link.label }}</a>
            {% endif %}
            {% endif %}
            {% endfor %}
        </nav>

        <div class="nav__right">
            {% if langSwitch %}
            <div class="lang-switch" role="group" aria-label="{{ nav.language }}">
                {% for langItem in langSwitch %}
                <a href="{{ langItem.href | prettyUrl }}" hreflang="{{ langItem.code | lower }}"{% if langItem.active %} class="active" aria-current="true"{% endif %} data-ga="select_content" data-ga-detail="lang_{{ langItem.code | lower }}">{{ langItem.code }}</a>
                {% endfor %}
            </div>
            {% endif %}
            <button class="icon-btn theme-toggle" type="button" aria-label="{{ nav.themeToggle }}">
                <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
            </button>
            <a href="{% if isHomepage %}#baixar{% else %}{{ homeHref }}#baixar{% endif %}" class="btn btn--primary btn--sm nav__cta" data-ga="select_content" data-ga-detail="navbar_cta">{{ nav.cta }}</a>
            <button class="icon-btn nav-toggle" type="button" aria-label="{{ nav.menu }}" aria-expanded="false" aria-controls="mobile-menu">
                <svg class="i-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                <svg class="i-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
        </div>
    </div>
</header>
