---
layout: layouts/base.njk
---
{# Hallmark · genre: modern-minimal · macrostructure: Long Document · design-system: design.md
   Legal wording lives in _data/legal.json and is not rewritten here. #}
{% set legalData = legal[pageType][langCode] %}
{% set tocLabel = { pt: 'Nesta página', en: 'On this page', es: 'En esta página' }[langCode] | default('Nesta página') %}

<header class="page-head">
    <div class="wrap">
        <h1>{{ legalData.title }} {{ legalData.titleHighlight }}</h1>
        <p class="lede">{{ legalData.subtitle }}</p>
        {% set lastUpdated = legalData.lastUpdated %}{% if legalData.lastUpdatedFlagged and (legalData.lastUpdatedFlagged | flagShown(site.flags)) %}{% set lastUpdated = legalData.lastUpdatedFlagged.text %}{% endif %}
        <p class="page-head__meta">{{ lastUpdated }}</p>
    </div>
</header>

{# Sections with `flag` show only when site.flags turns it on; numbered titles are renumbered in order #}
{% set shownSections = legalData.sections | legalSections(site.flags) %}
<div class="doc">
    <div class="wrap doc__grid">
        <nav class="toc" aria-labelledby="toc-label">
            <p class="label" id="toc-label">{{ tocLabel }}</p>
            <ol>
                {% for section in shownSections %}{% set title = section.title %}
                <li><a href="#{{ title | slugify }}">{{ title }}</a></li>
                {% endfor %}
            </ol>
        </nav>

        <article class="doc__body">
            {% for section in shownSections %}{% set title = section.title %}
            <section class="doc__section" aria-labelledby="{{ title | slugify }}">
                <h2 id="{{ title | slugify }}">{{ title }}</h2>
                {% for para in section.paragraphs %}
                <p>{{ para | safe }}</p>
                {% endfor %}
                {% if section.list %}
                <ul>
                    {% for item in section.list %}
                    <li>{{ item | safe }}</li>
                    {% endfor %}
                </ul>
                {% endif %}
                {% for para in section.paragraphsAfter %}
                <p>{{ para | safe }}</p>
                {% endfor %}
            </section>
            {% endfor %}
        </article>
    </div>
</div>
