---
layout: layouts/base.njk
pageType: support
pageStyles: content
supportStyles: true
---
{# Hallmark · genre: modern-minimal · macrostructure: Long Document (contact strip + topic rows + quick Q&A) · design-system: design.md #}
{% set sp = support[langCode] | default(support.pt) %}
{% set mail = 'mailto:' ~ site.email %}

<header class="page-head">
    <div class="wrap">
        <h1>{{ sp.title }}</h1>
        <p class="lede">{{ sp.lede }}</p>
    </div>
</header>

<div class="doc support">
    <div class="wrap">
        {# Contact strip — the two real channels, written like a form field #}
        <section class="support-contact" aria-labelledby="contato">
            <h2 id="contato" class="support-contact__title">{{ sp.contact.title }}</h2>
            <dl class="support-contact__rows">
                <div class="support-contact__row">
                    <dt class="label">{{ sp.contact.emailLabel }}</dt>
                    <dd>
                        <a class="support-contact__value mono" href="{{ mail }}?subject={{ sp.contact.emailSubject | urlencode }}" data-ga="generate_lead" data-ga-detail="support_email">{{ site.email }}</a>
                        <a class="btn btn--primary btn--sm" href="{{ mail }}?subject={{ sp.contact.emailSubject | urlencode }}" data-ga="generate_lead" data-ga-detail="support_email_button">{{ sp.contact.emailCta }}</a>
                    </dd>
                </div>
                {% if site.flags.whatsappContact %}
                <div class="support-contact__row">
                    <dt class="label">{{ sp.contact.whatsappLabel }}</dt>
                    <dd>
                        <a class="btn btn--secondary btn--sm" href="https://wa.me/{{ site.whatsapp.number }}?text={{ sp.contact.whatsappMessage | urlencode }}" target="_blank" rel="noopener" data-ga="generate_lead" data-ga-detail="support_whatsapp">{{ sp.contact.whatsappCta }}</a>
                    </dd>
                </div>
                {% endif %}
            </dl>
            <p class="support-contact__note">{{ sp.contact.note }}</p>
        </section>

        <section class="support-section" aria-labelledby="assuntos">
            <div class="section-head">
                <h2 id="assuntos">{{ sp.topics.title }}</h2>
                <p>{{ sp.topics.lede }}</p>
            </div>
            <ul class="topics" role="list">
                {% for topic in sp.topics.items %}
                <li class="topic">
                    <h3>{{ topic.title }}</h3>
                    <div class="topic__body">
                        <p>{{ topic.text }}</p>
                        <p class="topic__links">
                            {% for link in topic.links %}
                            {% if link.mailSubject %}
                            <a class="link" href="{{ mail }}?subject={{ link.mailSubject | urlencode }}" data-ga="generate_lead" data-ga-detail="{{ link.ga }}">{{ link.text }}</a>
                            {% else %}
                            <a class="link" href="{{ relPath }}{{ link.href | prettyUrl }}" data-ga="select_content" data-ga-detail="{{ link.ga }}">{{ link.text }}</a>
                            {% endif %}
                            {% endfor %}
                        </p>
                    </div>
                </li>
                {% endfor %}
            </ul>
        </section>

        <section class="support-section" aria-labelledby="respostas">
            <div class="section-head">
                <h2 id="respostas">{{ sp.quick.title }}</h2>
            </div>
            <div class="qa-list">
                {% for item in sp.quick.items %}
                <details class="qa">
                    <summary>{{ item.question }}</summary>
                    <div class="qa__answer"><p>{{ item.answer }}</p></div>
                </details>
                {% endfor %}
            </div>
            <p class="support-more"><a class="link" href="{{ relPath }}{{ faqLink }}" data-ga="select_content" data-ga-detail="support_all_faq">{{ sp.quick.allLink }}</a></p>
        </section>
    </div>
</div>
