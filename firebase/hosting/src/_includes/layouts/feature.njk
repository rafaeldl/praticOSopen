---
layout: layouts/base.njk
pageType: feature
---
{# Hallmark · genre: modern-minimal · macrostructure: Narrative Workflow (Split Studio rows) · design-system: design.md
 # Feature page. The WhatsApp assistant is behind site.flags.whatsappBot:
 #   on  → normal feature page with WhatsApp CTAs (hero demo, exchange table, numbered tasks, FAQ)
 #   off → honest notice + "where to do it in the app" table + FAQ; no bot CTAs anywhere
 #}
{% set data = features[featureSlug][langCode] %}
{% set botOn = site.flags.whatsappBot %}
{% set waMsg = site.whatsapp.messages[langCode] | default(site.whatsapp.messages.pt) %}
{% set homeHref = relPath + ('' if indexPage == './' else indexPage) %}
{% set faq = data.faq if botOn else data.faqOff %}

<section class="fx-hero">
    <div class="wrap fx-hero__grid">
        <div class="fx-hero__copy">
            <h1>{{ data.hero.title }}</h1>
            <p class="lede">{{ data.hero.lede if botOn else data.hero.ledeOff }}</p>

            {% if botOn %}
            <div class="btn-row">
                <a href="https://wa.me/{{ site.whatsapp.number }}?text={{ waMsg | urlencode }}" target="_blank" rel="noopener" class="btn btn--whatsapp" data-ga="generate_lead" data-ga-detail="whatsapp_hero">{% include "partials/icon-whatsapp.njk" %}{{ data.hero.ctaWhatsapp }}</a>
                <a href="#baixar" class="btn btn--secondary" data-ga="cta_click" data-ga-detail="hero_download">{{ data.hero.ctaDownload }}</a>
            </div>
            {% else %}
            <aside class="fx-notice" role="note" aria-labelledby="fx-notice-title">
                <p class="label">{{ data.notice.label }}</p>
                <h2 id="fx-notice-title" class="fx-notice__title">{{ data.notice.title }}</h2>
                <p class="fx-notice__text">{{ data.notice.text }}</p>
                <div class="btn-row">
                    <a href="{{ homeHref }}#baixar" class="btn btn--primary" data-ga="cta_click" data-ga-detail="whatsapp_bot_offline_download">{{ data.notice.cta }}</a>
                    <a href="#no-app" class="btn btn--text" data-ga="select_content" data-ga-detail="whatsapp_bot_offline_in_app">{{ data.hero.ctaSecondaryOff }}</a>
                </div>
            </aside>
            {% endif %}
        </div>

        {% if botOn %}
        <figure class="shot fx-hero__shot fx-hero__shot--demo">
            <picture>
                <source srcset="{{ relPath }}assets/images/whatsapp-bot-demo.webp" type="image/webp">
                <img src="{{ relPath }}assets/images/whatsapp-bot-demo.gif" alt="{{ data.hero.demoAlt }}" width="240" height="489" decoding="async">
            </picture>
            <figcaption>{{ data.hero.demoCaption }}</figcaption>
        </figure>
        {% else %}
        <figure class="shot fx-hero__shot">
            <img class="theme-light" src="{{ relPath }}assets/screenshots/{{ langCode }}/light/order-detail.png" alt="{{ data.hero.shotAlt }}" width="1170" height="2532" decoding="async">
            <img class="theme-dark" src="{{ relPath }}assets/screenshots/{{ langCode }}/dark/order-detail.png" alt="{{ data.hero.shotAlt }}" width="1170" height="2532" decoding="async" loading="lazy">
            <figcaption>{{ data.hero.shotCaption }}</figcaption>
        </figure>
        {% endif %}
    </div>
</section>

{% if botOn %}
{# What you send → what it does: a two-column ruled table #}
<section class="section">
    <div class="wrap">
        <div class="section-head">
            <h2>{{ data.exchange.title }}</h2>
            <p>{{ data.exchange.lede }}</p>
        </div>
        <table class="fx-table fx-table--2">
            <thead>
                <tr><th scope="col">{{ data.exchange.colYou }}</th><th scope="col">{{ data.exchange.colAssistant }}</th></tr>
            </thead>
            <tbody>
                {% for row in data.exchange.rows %}
                <tr>
                    <th scope="row" data-label="{{ data.exchange.colYou }}">{{ row.input }}</th>
                    <td data-label="{{ data.exchange.colAssistant }}">{{ row.result }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</section>

{# Numbered tasks — Split Studio rows: ordinal + claim left, detail right #}
<section class="section section--alt">
    <div class="wrap">
        <div class="section-head">
            <h2>{{ data.tasks.title }}</h2>
            <p>{{ data.tasks.lede }}</p>
        </div>
        <ol class="fx-tasks" role="list">
            {% for item in data.tasks.items %}
            <li class="fx-task">
                <span class="fx-task__num mono" aria-hidden="true">{{ "0" if loop.index < 10 }}{{ loop.index }}</span>
                <h3>{{ item.title }}</h3>
                <p>{{ item.text }}</p>
            </li>
            {% endfor %}
        </ol>
    </div>
</section>
{% else %}
{# Bot offline: where each task lives in the app #}
<section class="section" id="no-app">
    <div class="wrap">
        <div class="section-head">
            <h2>{{ data.inApp.title }}</h2>
            <p>{{ data.inApp.lede }}</p>
        </div>
        <table class="fx-table fx-table--3">
            <thead>
                <tr>
                    <th scope="col">{{ data.inApp.colAssistant }}</th>
                    <th scope="col">{{ data.inApp.colApp }}</th>
                    <th scope="col"><span class="fx-sr">{{ data.inApp.colGuide }}</span></th>
                </tr>
            </thead>
            <tbody>
                {% for row in data.inApp.rows %}
                <tr>
                    <th scope="row" data-label="{{ data.inApp.colAssistant }}">{{ row.assistant }}</th>
                    <td data-label="{{ data.inApp.colApp }}">{{ row.app }}</td>
                    <td class="fx-table__guide">{% if row.guide %}<a class="link" href="{{ relPath }}{{ row.guide }}">{{ data.inApp.guideLabel }}<span class="fx-sr">: {{ row.assistant }}</span></a>{% endif %}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{% endif %}

{# FAQ — ruled question list #}
<section class="section">
    <div class="wrap fx-faq">
        <div class="section-head">
            <h2>{{ faq.title }}</h2>
        </div>
        <dl class="fx-faq__list">
            {% for item in faq.items %}
            {% if not item.flag or site.flags[item.flag] %}
            <div class="fx-faq__item">
                <dt>{{ item.question }}</dt>
                <dd>{{ item.answer }}</dd>
            </div>
            {% endif %}
            {% endfor %}
        </dl>
    </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% set sep = joiner(",") %}
    {% for item in faq.items %}{% if not item.flag or site.flags[item.flag] %}{{ sep() }}
    { "@type": "Question", "name": {{ item.question | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | dump | safe }} } }
    {% endif %}{% endfor %}
  ]
}
</script>

{% include "components/download.njk" %}
