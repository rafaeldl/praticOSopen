---
layout: layouts/base.njk
pageType: pricing
pageStyles: [content, pricing]
---
{# Hallmark · genre: modern-minimal · macrostructure: Pricing (plan sheet + F3 spec sheet + conversational FAQ) · design-system: design.md #}
{% set data = pricingPage[langCode] | default(pricingPage.pt) %}
{% set homeHref = relPath ~ (indexPage | default('index.html') | prettyUrl) %}
{% set cmp = data.comparison %}
{% set planKeys = ['free', 'starter', 'pro', 'business'] %}

<header class="page-head">
    <div class="wrap">
        <h1>{{ data.header.titleBefore }} <span class="mark">{{ data.header.titleMark }}</span></h1>
        <p class="lede">{{ data.header.lede }}</p>
        <p class="page-head__terms mono">{{ data.header.terms | join(' · ') }}</p>
    </div>
</header>

{# Plan sheet — four columns of one ruled table; subscribing happens in the app #}
<section class="section pricing-plans" id="planos" aria-label="{{ cmp.caption }}">
    <div class="wrap">
        <div class="plans__sheet plans__sheet--four">
            {% for plan in data.plans %}
            <article class="plan{% if plan.featured %} plan--featured{% endif %}">
                <header class="plan__head">
                    <h2 class="plan__name">{{ plan.name }}{% if plan.badge %} <span class="plan__badge label">{{ plan.badge }}</span>{% endif %}</h2>
                    <p class="plan__tagline">{{ plan.tagline }}</p>
                    <p class="plan__price mono"><span class="plan__currency">{{ plan.currency }}</span>{{ plan.price }}<span class="plan__period">{{ plan.period }}</span></p>
                </header>
                <ul class="plan__features" role="list">
                    {% if plan.lead %}<li class="is-lead">{{ plan.lead }}</li>{% endif %}
                    {% for feature in plan.features %}<li>{{ feature }}</li>{% endfor %}
                </ul>
                <a href="{{ homeHref }}#baixar" class="btn {% if plan.featured %}btn--primary{% else %}btn--secondary{% endif %}" data-ga="select_content" data-ga-detail="pricing_{{ plan.name | lower | replace(' ', '_') }}">{{ plan.cta }}</a>
            </article>
            {% endfor %}
        </div>
        <p class="pricing-included"><span class="label">{{ data.included.label }}</span> {{ data.included.items | join(' · ') }}</p>
    </div>
</section>

{# F3 spec sheet — hairline rules, tabular mono figures, one column per plan #}
<section class="section section--alt" id="comparar">
    <div class="wrap">
        <div class="section-head">
            <h2>{{ cmp.title }}</h2>
            <p>{{ cmp.lede }}</p>
        </div>
        <p class="spec__hint">{{ cmp.scrollHint }}</p>
        <div class="spec" role="region" aria-label="{{ cmp.caption }}" tabindex="0">
            <table class="spec__table">
                <caption class="visually-hidden">{{ cmp.caption }}</caption>
                <thead>
                    <tr>
                        <th scope="col" class="spec__corner"><span class="label">{{ cmp.featureHeader }}</span></th>
                        {% for plan in data.plans %}
                        <th scope="col" class="spec__plan{% if plan.featured %} is-featured{% endif %}">
                            <span class="spec__plan-name">{{ plan.name }}</span>
                            <span class="spec__plan-price mono">{{ cmp.prices[planKeys[loop.index0]] }}{% if plan.price != '0' %} <small>{{ cmp.perMonth }}</small>{% endif %}</span>
                        </th>
                        {% endfor %}
                    </tr>
                </thead>
                {% for group in cmp.groups %}
                <tbody>
                    <tr class="spec__group">
                        <th scope="colgroup" colspan="5"><span>{{ group.title }}</span></th>
                    </tr>
                    {% for row in group.rows %}
                    <tr>
                        <th scope="row">{{ row.feature }}</th>
                        {% for key in planKeys %}
                        {% set value = row[key] %}
                        <td class="{% if key == 'starter' %}is-featured{% endif %}">
                            {% if value == '✓' %}<span class="spec__yes" aria-hidden="true"></span><span class="visually-hidden">{{ cmp.yes }}</span>
                            {% elif value == '—' %}<span class="spec__no" aria-hidden="true">—</span><span class="visually-hidden">{{ cmp.no }}</span>
                            {% else %}<span class="mono">{{ value }}</span>{% endif %}
                        </td>
                        {% endfor %}
                    </tr>
                    {% endfor %}
                </tbody>
                {% endfor %}
            </table>
        </div>
    </div>
</section>

{# Conversational FAQ — native disclosure #}
<section class="section" id="duvidas">
    <div class="wrap">
        <div class="section-head">
            <h2>{{ data.faq.title }}</h2>
            <p>{{ data.faq.lede }}</p>
        </div>
        <div class="qa-list">
            {% for item in data.faq.items %}
            <details class="qa">
                <summary>{{ item.question }}</summary>
                <div class="qa__answer"><p>{{ item.answer | safe }}</p></div>
            </details>
            {% endfor %}
        </div>
    </div>
</section>

{% include "components/download.njk" %}
