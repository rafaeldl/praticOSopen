---
layout: layouts/base.njk
docsStyles: true
pageType: docs
---
{# Hallmark · genre: modern-minimal · macrostructure: Long Document (Index-First) · design-system: design.md
   Data: docs.json → hub[lang] = { title, subtitle, filterLabel, filterPlaceholder, countOne, countMany, empty*,
   groups: [{ title, items: [{ title, description, href, flag? }] }], quickLinksTitle, quickLinks: [{ title, description, href }] }.
   An item with `flag` only renders when site.flags[flag] is true. #}
{% set hub = docs.hub[langCode] | default(docs.hub.pt) %}
<div class="wrap hub">
    <header class="hub__head">
        <h1>{{ hub.title }}</h1>
        <p class="lede">{{ hub.subtitle }}</p>
    </header>

    <div class="hub__filter" data-filter hidden>
        <label class="label" for="docs-filter">{{ hub.filterLabel }}</label>
        <input type="search" id="docs-filter" placeholder="{{ hub.filterPlaceholder }}" autocomplete="off" spellcheck="false" aria-describedby="docs-filter-count">
        <p class="hub__count" id="docs-filter-count" aria-live="polite" data-count-one="{{ hub.countOne }}" data-count-many="{{ hub.countMany }}"></p>
    </div>

    {% for group in hub.groups %}
    <section class="hub__group" aria-labelledby="grupo-{{ loop.index }}" data-group>
        <h2 id="grupo-{{ loop.index }}">{{ group.title }}</h2>
        <ul class="doc-index" role="list">
            {% for item in group.items %}
            {% if not item.flag or site.flags[item.flag] %}
            <li data-item>
                <a class="doc-index__link" href="{{ item.href }}">
                    <span class="doc-index__title">{{ item.title }}</span>
                    <span class="doc-index__arrow" aria-hidden="true">→</span>
                    <span class="doc-index__desc">{{ item.description }}</span>
                </a>
            </li>
            {% endif %}
            {% endfor %}
        </ul>
    </section>
    {% endfor %}

    <p class="hub__empty" data-empty hidden>{{ hub.emptyLead }} <a href="{{ faqLink }}">{{ hub.emptyFaq }}</a> {{ hub.emptyOr }} <a href="{{ supportLink }}">{{ hub.emptySupport }}</a>.</p>

    <section class="hub__more" aria-labelledby="mais-ajuda">
        <h2 id="mais-ajuda">{{ hub.quickLinksTitle }}</h2>
        <ul class="doc-index" role="list">
            {% for link in hub.quickLinks %}
            <li>
                <a class="doc-index__link" href="{{ link.href }}">
                    <span class="doc-index__title">{{ link.title }}</span>
                    <span class="doc-index__arrow" aria-hidden="true">→</span>
                    <span class="doc-index__desc">{{ link.description }}</span>
                </a>
            </li>
            {% endfor %}
        </ul>
    </section>
</div>

<script>
(function () {
    var box = document.querySelector('[data-filter]');
    if (!box) return;
    box.hidden = false; // filter only exists when JS can run it
    var input = box.querySelector('input');
    var count = box.querySelector('.hub__count');
    var items = Array.prototype.slice.call(document.querySelectorAll('[data-item]'));
    var groups = Array.prototype.slice.call(document.querySelectorAll('[data-group]'));
    var empty = document.querySelector('[data-empty]');
    function norm(s) { return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, ''); }
    var texts = items.map(function (li) { return norm(li.textContent); });

    input.addEventListener('input', function () {
        var q = norm(input.value.trim());
        var shown = 0;
        items.forEach(function (li, i) {
            var match = !q || texts[i].indexOf(q) !== -1;
            li.hidden = !match;
            if (match) shown++;
        });
        groups.forEach(function (g) { g.hidden = !g.querySelector('[data-item]:not([hidden])'); });
        empty.hidden = shown !== 0;
        count.textContent = q ? (shown === 1 ? count.dataset.countOne : count.dataset.countMany.replace('{n}', shown)) : '';
    });
})();
</script>
