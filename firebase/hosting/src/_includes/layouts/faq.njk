---
layout: layouts/base.njk
pageType: faq
pageStyles: content
---
{# Hallmark · genre: modern-minimal · macrostructure: Long Document · design-system: design.md #}
{% set faqData = faq[langCode] | default(faq.pt) %}
{# A group or item with `flag` shows only when site.flags[flag] is on; with `hideWhenFlag`, only while it is off. #}

<header class="page-head">
    <div class="wrap">
        <h1>{{ faqData.title }}</h1>
        <p class="lede">{{ faqData.lede }}</p>
    </div>
</header>

<div class="doc">
    <div class="wrap doc__grid">
        <nav class="toc" aria-labelledby="toc-label">
            <p class="label" id="toc-label">{{ faqData.tocLabel }}</p>
            <ol>
                {% for group in faqData.groups %}{% if group | flagShown(site.flags) %}
                <li><a href="#{{ group.id }}">{{ group.title }}</a></li>
                {% endif %}{% endfor %}
            </ol>
        </nav>

        <div class="doc__body">
            {% for group in faqData.groups %}{% if group | flagShown(site.flags) %}
            <section class="doc__section" aria-labelledby="{{ group.id }}">
                <h2 id="{{ group.id }}">{{ group.title }}</h2>
                <div class="qa-list">
                    {% for item in group.items %}{% if item | flagShown(site.flags) %}
                    <details class="qa">
                        <summary>{{ item.question }}</summary>
                        <div class="qa__answer"><p>{{ item.answer | safe }}</p></div>
                    </details>
                    {% endif %}{% endfor %}
                </div>
            </section>
            {% endif %}{% endfor %}
        </div>
    </div>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% set sep = joiner(",") %}
    {% for group in faqData.groups %}{% if group | flagShown(site.flags) %}{% for item in group.items %}{% if item | flagShown(site.flags) %}{{ sep() }}
    {
      "@type": "Question",
      "name": {{ item.question | dump | safe }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ item.answer | striptags | dump | safe }}
      }
    }{% endif %}{% endfor %}{% endif %}{% endfor %}
  ]
}
</script>
