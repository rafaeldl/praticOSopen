# The Deliverfile allows you to store various App Store Connect metadata
# For more information, check out the docs
# https://docs.fastlane.tools/actions/deliver/

# App Review Information (demo account and notes) comes from
# metadata/review_information/*.txt. Do not set app_review_information here:
# values in this file take precedence over those files.

# Automatically submit for review after upload
submit_for_review false

# Screenshots: only the 6.9" iPhone set in screenshots/{locale}/ (App Store
# Connect scales it down). Dark ones live in screenshots_dark/ for the website.
skip_screenshots false

# Replace what is in App Store Connect instead of adding to it
overwrite_screenshots true

# Never upload a build from here
skip_binary_upload true

# Skip metadata upload if you want to manage it manually
# skip_metadata true
